# =============================================================================
# GitLab Security Addon - Low Memory Configuration
# Dành cho server < 8GB RAM
# =============================================================================

GITLAB_OMNIBUS_CONFIG=external_url 'http://gitlab.local:8080'; gitlab_rails['gitlab_ssh_host'] = 'gitlab.local'; gitlab_rails['gitlab_shell_ssh_port'] = 2222; puma['worker_processes'] = 1; sidekiq['max_concurrency'] = 5; postgresql['shared_buffers'] = '128MB'; prometheus_monitoring['enable'] = false; alertmanager['enable'] = false; node_exporter['enable'] = false; redis_exporter['enable'] = false; postgres_exporter['enable'] = false; gitlab_exporter['enable'] = false; grafana['enable'] = false; nginx['worker_processes'] = 1
