# =============================================================================
# GitLab Security Addon - Environment Variables
# =============================================================================

# GitLab URL
EXTERNAL_URL=http://your-server-ip:8080

# SSH port
SSH_PORT=2222

# PostgreSQL connection string (lấy từ Coolify PostgreSQL service)
# Format: postgresql://user:password@host:5432/gitlabhq_production
DATABASE_URL=postgresql://gitlab:your-password@postgres-host:5432/gitlabhq_production
